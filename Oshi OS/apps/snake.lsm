fulldev

import "kernel/vga.lsm";
import "kernel/keyboard.lsm";

fct snake_main() -> void {
    let bg = 0;
    let main_game_active = 1;

    while (main_game_active == 1) {
        vga_clear(bg);

        // رسم الإطار أوسع بدقة 100x37
        let x = 0;
        while (x < 98) {
            vga_putc(35, x, 0, 10);
            vga_putc(35, x, 35, 10);
            x = x + 1;
        }
        let y = 0;
        while (y < 36) {
            vga_putc(35, 0, y, 10);
            vga_putc(35, 97, y, 10);
            y = y + 1;
        }

        vga_putc(83, 2, 0, 14); vga_putc(78, 3, 0, 14); vga_putc(65, 4, 0, 14);
        vga_putc(75, 5, 0, 14); vga_putc(69, 6, 0, 14);
        vga_putc(124, 8, 0, 14);

        vga_putc(83, 10, 0, 15); vga_putc(67, 11, 0, 15); vga_putc(79, 12, 0, 15);
        vga_putc(82, 13, 0, 15); vga_putc(69, 14, 0, 15); vga_putc(58, 15, 0, 15);

        let score = 0;
        vga_putc(48, 17, 0, 15); vga_putc(48, 18, 0, 15); vga_putc(48, 19, 0, 15);

        let head_x = 48;
        let head_y = 18;
        let dir = 4;

        let food_x = 30;
        let food_y = 12;
        vga_putc(42, food_x, food_y, 12);
        vga_flip();

        let is_alive = 1;
        while (is_alive == 1) {
            let tick = 0;
            let speed_ticks = 400000;
            if (dir == 1 || dir == 2) { speed_ticks = 650000; }

            while (tick < speed_ticks) {
                let ch = kbd_getc();
                
                if (ch == 27) {
                    is_alive = 0;
                    main_game_active = 0;
                    tick = speed_ticks;
                }
                else if (ch == 201 || ch == 122 || ch == 90) { if (dir != 2) { dir = 1; } }
                else if (ch == 202 || ch == 115 || ch == 83) { if (dir != 1) { dir = 2; } }
                else if (ch == 203 || ch == 113 || ch == 81) { if (dir != 4) { dir = 3; } }
                else if (ch == 204 || ch == 100 || ch == 68) { if (dir != 3) { dir = 4; } }

                tick = tick + 1;
            }

            if (is_alive == 1) {
                vga_putc(32, head_x, head_y, bg);

                if (dir == 1) { head_y = head_y - 1; }
                else if (dir == 2) { head_y = head_y + 1; }
                else if (dir == 3) { head_x = head_x - 1; }
                else if (dir == 4) { head_x = head_x + 1; }

                if (head_x <= 0 || head_x >= 97 || head_y <= 0 || head_y >= 35) {
                    is_alive = 0;
                } else {
                    vga_putc(79, head_x, head_y, 14);

                    if (head_x == food_x && head_y == food_y) {
                        score = score + 10;

                        let s_h = score / 100;
                        let s_t = (score - (s_h * 100)) / 10;
                        let s_o = score - (s_h * 100) - (s_t * 10);
                        vga_putc(48 + s_h, 17, 0, 15);
                        vga_putc(48 + s_t, 18, 0, 15);
                        vga_putc(48 + s_o, 19, 0, 15);

                        food_x = (food_x * 7 + 11) - (((food_x * 7 + 11) / 80) * 80) + 8;
                        food_y = (food_y * 5 + 3)  - (((food_y * 5 + 3) / 28) * 28) + 4;
                        vga_putc(42, food_x, food_y, 12);
                    }
                }
                vga_flip();
            }
        }

        if (main_game_active == 1) {
            let gx = 35;
            let gy = 15;

            vga_putc(71, gx, gy, 14); vga_putc(65, gx+1, gy, 14); vga_putc(77, gx+2, gy, 14);
            vga_putc(69, gx+3, gy, 14); vga_putc(32, gx+4, gy, 14); vga_putc(79, gx+5, gy, 14);
            vga_putc(86, gx+6, gy, 14); vga_putc(69, gx+7, gy, 14); vga_putc(82, gx+8, gy, 14);
            vga_flip();

            let waiting = 1;
            while (waiting == 1) {
                let decision = kbd_getc();
                if (decision == 32) { waiting = 0; }
                else if (decision == 27) { waiting = 0; main_game_active = 0; }
            }
        }
    }
}